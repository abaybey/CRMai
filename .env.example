# ====================================================================
# RETAIL INTELLIGENCE OS — ENVIRONMENT VARIABLES
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION
# --------------------------------------------------------------------
# Safe for browser (Exposed to client bundle via NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SERVER-SIDE ONLY: Never expose to browser bundle.
# Used exclusively in secure server actions/routes for admin tasks & RLS bypass where authorized.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --------------------------------------------------------------------
# 2. AI MODEL PROVIDER CONFIGURATION
# --------------------------------------------------------------------
# SERVER-SIDE ONLY: Used for server-side narrative generation and WhatsApp drafts
# If left empty, Retail Intelligence OS automatically falls back to the deterministic
# heuristic retail analysis engine with 100% functionality and zero downtime.
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-pro

# --------------------------------------------------------------------
# 3. ENVIRONMENT & APP SETTINGS
# --------------------------------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE=Asia/Jakarta
NEXT_PUBLIC_APP_CURRENCY=IDR
NEXT_PUBLIC_ENABLE_DEMO_MODE=true
